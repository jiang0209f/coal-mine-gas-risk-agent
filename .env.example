DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_MAX_TOKENS=512
# 普通对话和主动简报共用的云端来源列表；仅限纯合成隔离库，真实运行库保持空。
EVENT_BRIEF_ALLOWED_SOURCE_IDS=[]
# 自动处理已启用接入配置的本地待入库批次；未启用的配置保持排队。
INGESTION_WORKER_ENABLED=true
# 服务端推进运行中的实时会话，浏览器关闭后继续监测。
REALTIME_MONITOR_ENABLED=true
REALTIME_MONITOR_INTERVAL_SECONDS=5
RUNTIME_DIR=local_data
# 留空使用RUNTIME_DIR/app.db，也可提供postgresql+psycopg连接。
DATABASE_URL=
# 可选：受信任的本地模型目录清单，权重与模型环境放在F盘。
MODEL_CATALOG_PATH=
# 可选：已离线导出并核验manifest.json的中文文本向量模型目录。
KNOWLEDGE_EMBEDDING_MODEL_DIR=
# 留空使用RUNTIME_DIR/knowledge-index，实际模型与索引应放F盘。
KNOWLEDGE_INDEX_DIR=
